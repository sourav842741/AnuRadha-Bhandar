# =========================================
# SNAPCART - Socket Server Environment
# =========================================
# Copy this file to ".env" and fill in your own values.
#   cp .env.example .env

# Base URL of the Next.js app (used to call backend API routes)
NEXT_PUBLIC_API_URL=http://localhost:3000

# Port the socket server runs on (defaults to 4000)
PORT=4000

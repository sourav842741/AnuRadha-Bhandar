# =========================================
# SNAPCART - Next.js App Environment
# =========================================
# Copy this file to ".env.local" and fill in your own values.
#   cp .env.example .env.local

# ---------- MongoDB ----------
MONGODB_URL=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/

# ---------- NextAuth (JWT Auth Secret) ----------
# Generate one with:  openssl rand -base64 32
AUTH_SECRET="your-random-auth-secret"

# ---------- Google OAuth (https://console.cloud.google.com/apis/credentials) ----------
GOOGLE_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxx

# ---------- App URLs ----------
NEXT_PUBLIC_BASE_URL=http://localhost:3000
# Socket server URL (must match the port the socket server runs on)
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# ---------- Cloudinary (https://cloudinary.com) ----------
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ---------- Nodemailer (Gmail App Password) ----------
# Enable 2-Step Verification on your Google account, then create an App Password.
MAIL_USER=youremail@gmail.com
MAIL_PASS=your-gmail-app-password

# ---------- Google Gemini AI (https://aistudio.google.com) ----------
NEXT_PUBLIC_GEMINI_API_KEY=your-gemini-api-key
GEMINI_API_KEY=your-gemini-api-key

# ---------- Razorpay (https://dashboard.razorpay.com) ----------
# Test mode keys start with "rzp_test_"
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
